{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "List(*)",
      "Fetch(https://*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(git reset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(.tool_input.command) - \\(.tool_input.description // \"No description\")\"' >> ~/.claude/bash-command-log.txt"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-pip-install.sh",
            "statusMessage": "Checking for prohibited pip install..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "for file in $(echo \"$TOOL_RESULT\" | jq -r '.files_edited[]? // empty'); do if [[ \"$file\" == *.py ]]; then python -m py_compile \"$file\" 2>&1 || echo \"⚠️  Python syntax check failed for $file\"; fi; done",
            "statusMessage": "Checking Python syntax..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ruff-check.sh",
            "statusMessage": "Running ruff check..."
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "coding-assistant@claude-coding-assistant": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "codex@openai-codex": true,
    "ponytail@ponytail": true,
    "typesafe@typesafe-ai": true,
    "yomiyasu@yomiyasu": true,
    "pstack@cursor-plugins": true,
    "i-have-adhd@i-have-adhd": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true{{ $autoMode := joinPath .chezmoi.homeDir ".config/chezmoi/claude-automode.json" }}{{ if stat $autoMode }},
  "autoMode": {{ include $autoMode | trim }}{{ end }}
}
